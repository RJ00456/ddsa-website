const assistanceForm = document.querySelector('#assistance-form');

if (assistanceForm) {
  assistanceForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = assistanceForm.querySelector('button[type="submit"]');
    submitBtn.disabled = true;
    submitBtn.innerText = 'Submitting...';

    const payload = {
      fullName: document.querySelector('#full-name').value,
      phone: document.querySelector('#phone-number').value,
      email: document.querySelector('#email-address').value,
      homeState: document.querySelector('#home-state').value,
      college: document.querySelector('#college-name').value,
      assistanceType: document.querySelector('#assistance-type').value,
      query: document.querySelector('#query-description').value
    };

    try {
      const response = await fetch('/.netlify/functions/submit-assistance', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (!response.ok) throw new Error(result.error || 'Submission failed');

      alert('Thank you! Your request has been received by the DDSA student welfare team.');
      assistanceForm.reset();
    } catch (err) {
      alert(`Error: ${err.message}`);
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerText = 'Submit Request';
    }
  });
}
